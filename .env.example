# =====================================================================
# e-learn — Environment Variables template
# Copy to .env (local) or set the same keys on Vercel. NEVER commit .env.
# =====================================================================

# --- Database (Supabase Postgres) -----------------------------------
# Pooled (Transaction mode via PgBouncer) — runtime app connection.
DATABASE_URL="postgresql://postgres.{ref}:{password}@aws-0-{region}.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"
# Direct (Session mode) — used by prisma migrate/db push.
DIRECT_URL="postgresql://postgres:{password}@db.{ref}.supabase.co:5432/postgres"

# --- Auth (JWT signing) ---------------------------------------------
# >= 32 random chars. Generate with: openssl rand -hex 32
JWT_SECRET=""

# --- App ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="e-learn"
NEXT_PUBLIC_BASE_URL="https://your-app.vercel.app"

# --- Supabase (server-only service role + public anon) -------------
SUPABASE_URL="https://{ref}.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# --- Realtime socket.io mini-service --------------------------------
NEXT_PUBLIC_SOCKET_PORT="3003"

# --- Optional integrations (server-only) ----------------------------
RESEND_API_KEY=""
EMAIL_FROM="e-learn <onboarding@resend.dev>"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Firebase client SDK (exposed to browser)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# Upstash Redis (rate limiting). Optional.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
