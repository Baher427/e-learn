# ============================================================
# e-learn — Environment Variables (Firebase edition) — TEMPLATE
# ============================================================
# Copy to .env and fill in the real values.
# NEVER commit real secrets — .env is gitignored.

# --- Database + FCM (Firebase Admin service account) ---------------
# Paste the FULL service-account JSON (from Firebase Console →
# Project Settings → Service Accounts → Generate new private key)
# as ONE line below. Alternatively use the three discrete vars.
FIREBASE_SERVICE_ACCOUNT="{}"
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# --- Auth (JWT signing) ---------------------------------------------
JWT_SECRET="change-me-to-a-random-32-plus-char-string"

# --- App ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="e-learn"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Realtime socket.io mini-service --------------------------------
NEXT_PUBLIC_SOCKET_PORT="3003"

# --- Firebase client SDK (browser push, optional) -------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# --- Local testing only (Firestore emulator) — NEVER on Vercel ------
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Upstash Redis (rate limiting). Optional; in-memory fallback. ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
